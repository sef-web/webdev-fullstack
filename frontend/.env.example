# Frontend environment variables
# Copy to .env.local (for local dev) or configure in your hosting provider (Render Static Site)

# Backend API base URL
REACT_APP_API_URL=http://localhost:8800

# Cloudinary settings
# Find your cloud name on Cloudinary Dashboard (top-right of console)
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Create an unsigned upload preset in Cloudinary Settings > Upload > Upload presets
# Give it a name like `web_unsigned` and paste it here
REACT_APP_CLOUDINARY_UPLOAD_PRESET=web_unsigned
